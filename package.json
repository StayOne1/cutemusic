{
  "name": "cutemusic",
  "version": "1.0.0",
  "description": "CuteMusic - Desktop Music Pet",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable"
  },
  "keywords": [
    "music",
    "desktop-pet",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "electron-store": "^11.0.2",
    "music-metadata": "^11.13.0"
  },
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.cutemusic.app",
    "productName": "CuteMusic",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "data/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "build/resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "extraResources": [
      {
        "from": "data",
        "to": "data"
      }
    ]
  }
}
